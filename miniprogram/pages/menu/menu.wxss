.container { padding: 20rpx; }

.meal-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 133, 162, 0.1);
}
.meal-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 26rpx;
  transition: all 0.3s;
}
.meal-tab.active {
  background: linear-gradient(135deg, #FFB3C6, #FF85A2);
  box-shadow: 0 4rpx 12rpx rgba(255, 133, 162, 0.3);
}
.mt-emoji { font-size: 40rpx; }
.mt-text { font-size: 24rpx; margin-top: 4rpx; color: #8A6A6A; }
.meal-tab.active .mt-text { color: #FFFFFF; font-weight: 500; }

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #5A4A4A;
  margin: 30rpx 4rpx 16rpx;
}
.title-btns { display: flex; align-items: center; gap: 16rpx; }
.add-btn-top { padding: 14rpx 30rpx; font-size: 26rpx; font-weight: normal; }
.import-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  background: #FFF0D4;
  color: #D8942C;
  border: 1px solid #FFE0A8;
  border-radius: 30rpx;
}
.clear-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  background: #FFE5EC;
  color: #FF6B8A;
  border: 1px solid #FFD7E0;
  border-radius: 30rpx;
}

.menu-list { display: flex; flex-direction: column; gap: 16rpx; }
.menu-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #FFE5EC;
  box-shadow: 0 4rpx 12rpx rgba(255, 133, 162, 0.08);
}
.menu-top { display: flex; align-items: center; }
.menu-emoji {
  font-size: 48rpx;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FFF5F7;
  border-radius: 20rpx;
  margin-right: 20rpx;
}
.menu-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  background: #FFF5F7;
  border: 2rpx solid #FFE5EC;
}
.menu-info { flex: 1; }
.menu-name { font-size: 30rpx; font-weight: 500; color: #5A4A4A; }
.menu-nutri { font-size: 22rpx; color: #B0A0A0; margin-top: 8rpx; }
.menu-nutri .dot { margin: 0 8rpx; }
.menu-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #FFE5EC;
}
.edit-btn, .del-btn { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }
.edit-btn { background: #FFF0D4; color: #D8942C; }
.del-btn { background: #FFE5EC; color: #FF6B8A; }

/* 弹窗表单 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(90, 74, 74, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-content {
  width: 620rpx;
  max-height: 85vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 40rpx;
  animation: pop 0.3s;
}
@keyframes pop {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.modal-title { font-size: 34rpx; font-weight: bold; color: #5A4A4A; text-align: center; margin-bottom: 30rpx; }

.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #8A6A6A; display: block; margin-bottom: 12rpx; }
.form-input {
  background: #FFF5F7;
  border: 2rpx solid #FFE5EC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #5A4A4A;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.emoji-opt {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  background: #FFF5F7;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.emoji-opt.active {
  background: #FFE5EC;
  border-color: #FF6B8A;
  transform: scale(1.1);
}

.cat-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.cat-opt {
  padding: 14rpx 24rpx;
  background: #FFF5F7;
  border: 2rpx solid #FFE5EC;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #8A6A6A;
}
.cat-opt.active {
  background: linear-gradient(135deg, #FFB3C6, #FF85A2);
  color: #FFFFFF;
  border-color: #FF85A2;
}

.nutri-row { display: flex; gap: 16rpx; }
.nutri-input { flex: 1; }

.modal-btns { display: flex; gap: 20rpx; margin-top: 36rpx; }
.modal-btns .btn-cute, .modal-btns .btn-primary { flex: 1; }

/* 识别标识 */
.match-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  vertical-align: middle;
  background: #D4F0E8;
  color: #4A9B85;
}
.match-tag.unmatched {
  background: #FFF0D4;
  color: #D8942C;
}

/* 自动识别营养结果 */
.nutri-result {
  background: linear-gradient(135deg, #FFF5F7, #FFE5EC);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}
.nutri-result.empty {
  text-align: center;
  color: #C8B8B8;
  font-size: 24rpx;
  padding: 36rpx;
  background: #F5F0F0;
}
.nutri-result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.nutri-result-title { font-size: 26rpx; font-weight: 600; color: #5A4A4A; }
.match-badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: #D4F0E8;
  color: #4A9B85;
}
.match-badge.unmatched {
  background: #FFF0D4;
  color: #D8942C;
}
.nutri-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.nutri-cell {
  width: calc(33.33% - 8rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nc-val { font-size: 30rpx; font-weight: bold; color: #FF6B8A; }
.nc-name { font-size: 18rpx; color: #B0A0A0; margin-top: 4rpx; }
.re-match {
  text-align: center;
  font-size: 22rpx;
  color: #FF6B8A;
  margin-top: 16rpx;
  padding: 10rpx;
}
.nutri-tip {
  text-align: center;
  font-size: 20rpx;
  color: #C8B8B8;
  margin-top: 8rpx;
}

/* ===== 图片上传 ===== */
.img-upload-area {
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-upload-btn {
  width: 100%;
  height: 240rpx;
  background: #FFF5F7;
  border: 2rpx dashed #FFD7E0;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.upload-icon { font-size: 60rpx; }
.upload-text { font-size: 26rpx; color: #FF6B8A; }
.upload-tip { font-size: 20rpx; color: #C8B8B8; }

.img-preview {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}
.preview-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 24rpx;
  border: 2rpx solid #FFE5EC;
}
.img-remove {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: #FF6B8A;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 32rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 138, 0.4);
}
