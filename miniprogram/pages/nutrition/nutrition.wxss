.container { padding: 20rpx; }

.top-bar { padding: 24rpx 30rpx; }
.date-label { font-size: 24rpx; color: #B0A0A0; }
.role-text { font-size: 30rpx; font-weight: 500; color: #5A4A4A; margin-top: 6rpx; }
.switch-btn {
  background: #FFD7E0;
  color: #FF6B8A;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.overview {
  text-align: center;
  padding: 50rpx 30rpx;
}
.cal-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: conic-gradient(#FF85A2 {{percents.calories}}%, #FFE5EC {{percents.calories}}%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  position: relative;
}
.cal-circle::before {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #FFFFFF;
}
.cal-num { position: relative; font-size: 60rpx; font-weight: bold; color: #FF6B8A; }
.cal-unit { position: relative; font-size: 24rpx; color: #B0A0A0; }
.cal-label { font-size: 28rpx; color: #8A6A6A; margin-top: 24rpx; }
.cal-tip { font-size: 24rpx; color: #B0A0A0; margin-top: 12rpx; }

.nutri-item { margin: 24rpx 0; }
.nutri-head { margin-bottom: 12rpx; }
.nutri-name { font-size: 28rpx; color: #5A4A4A; }
.nutri-val { font-size: 24rpx; color: #B0A0A0; }
.nutri-bar {
  height: 20rpx;
  background: #FFF5F7;
  border-radius: 10rpx;
  overflow: hidden;
}
.nutri-inner {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s;
}
.nutri-inner.fat { background: linear-gradient(90deg, #FFD89B, #FFA94D); }
.nutri-inner.protein { background: linear-gradient(90deg, #B3E5C1, #4CAF6E); }
.nutri-inner.carb { background: linear-gradient(90deg, #C5CAE9, #7986CB); }
.nutri-inner.fiber { background: linear-gradient(90deg, #B8E0D2, #5BB89E); }
.nutri-inner.sugar { background: linear-gradient(90deg, #FFC4D6, #FF8FA8); }
.nutri-inner.sodium { background: linear-gradient(90deg, #D4D4E8, #8B8BB5); }
.nutri-inner.calcium { background: linear-gradient(90deg, #D4E5FF, #8AC0FF); }
.nutri-inner.vitA { background: linear-gradient(90deg, #FFE0B0, #FFB347); }
.nutri-inner.cal { background: linear-gradient(90deg, #FFB3C6, #FF6B8A); }

.tips-card { background: linear-gradient(135deg, #FFF9E8, #FFF5F7); }
.tip-line {
  font-size: 26rpx;
  color: #8A6A6A;
  padding: 10rpx 0;
  line-height: 1.6;
}

.meal-dist { margin: 20rpx 0; padding-bottom: 16rpx; border-bottom: 2rpx dashed #FFE5EC; }
.meal-dist:last-child { border-bottom: none; }
.md-name { font-size: 28rpx; color: #5A4A4A; }
.md-cal { font-size: 24rpx; color: #FF6B8A; }
.meal-bar {
  height: 12rpx;
  background: #FFF5F7;
  border-radius: 8rpx;
  margin: 12rpx 0;
  overflow: hidden;
}
.meal-inner {
  height: 100%;
  background: linear-gradient(90deg, #FFB3C6, #FF6B8A);
  border-radius: 8rpx;
}
.meal-foods { display: flex; flex-wrap: wrap; gap: 10rpx; }
.food-tag {
  background: #FFF5F7;
  border: 2rpx solid #FFE5EC;
  color: #8A6A6A;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.meal-empty { font-size: 24rpx; color: #C8B8B8; }

.footer-tip {
  text-align: center;
  color: #D8B8B8;
  font-size: 24rpx;
  margin: 30rpx 0;
  letter-spacing: 4rpx;
}
