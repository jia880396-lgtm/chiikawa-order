.container { padding: 20rpx; }

/* 想你了大按钮 */
.think-btn {
  position: relative;
  height: 240rpx;
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #FFB3C6, #FF85A2);
  box-shadow: 0 8rpx 24rpx rgba(255, 133, 162, 0.3);
  transition: transform 0.2s;
}
.think-btn:active { transform: scale(0.97); }
.think-img {
  width: 100%;
  height: 100%;
  opacity: 0.6;
}
.think-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.think-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.5);
}
.think-sub {
  font-size: 26rpx;
  color: #FFE5EC;
  margin-top: 12rpx;
}

/* 快捷互动 */
.quick-section { margin: 0 0 20rpx; }
.quick-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #5A4A4A;
  margin-bottom: 24rpx;
}
.quick-actions {
  display: flex;
  justify-content: space-around;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-circle {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 52rpx;
  background: linear-gradient(135deg, #FFE5EC, #FFD7E0);
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(255, 133, 162, 0.2);
  transition: transform 0.2s;
}
.quick-item:active .quick-circle {
  transform: scale(0.9);
  background: linear-gradient(135deg, #FFB3C6, #FF85A2);
}
.quick-label {
  font-size: 24rpx;
  color: #8A6A6A;
  margin-top: 14rpx;
}

/* 统计 */
.stat-bar {
  display: flex;
  align-items: center;
  margin: 0 0 20rpx;
}
.stat-emoji { font-size: 36rpx; margin-right: 12rpx; }
.stat-text { font-size: 28rpx; color: #5A4A4A; }
.stat-num { font-size: 36rpx; font-weight: bold; color: #FF6B8A; margin: 0 6rpx; }

/* 留言板 */
.board-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #5A4A4A;
  margin: 10rpx 4rpx 16rpx;
}
.input-bar {
  display: flex;
  align-items: center;
  margin: 0 0 20rpx;
}
.msg-input {
  flex: 1;
  font-size: 28rpx;
  color: #5A4A4A;
  padding: 12rpx 20rpx;
}
.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

/* 留言列表 */
.msg-list { display: flex; flex-direction: column; }
.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-item.other { flex-direction: row; }
.msg-item.mine { flex-direction: row-reverse; }
.msg-avatar {
  font-size: 44rpx;
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  flex-shrink: 0;
}
.msg-bubble {
  max-width: 460rpx;
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  margin: 0 16rpx;
}
.msg-item.other .msg-bubble {
  background: #FFFFFF;
  border: 2rpx solid #FFE5EC;
  border-top-left-radius: 8rpx;
}
.msg-item.mine .msg-bubble {
  background: #FFE5EC;
  border-top-right-radius: 8rpx;
}
.msg-tag {
  font-size: 22rpx;
  color: #FF6B8A;
  margin-bottom: 8rpx;
}
.msg-content {
  font-size: 28rpx;
  color: #5A4A4A;
  line-height: 1.5;
}
.msg-time {
  font-size: 20rpx;
  color: #B0A0A0;
  margin-top: 10rpx;
}

.tab-placeholder { height: 140rpx; }

/* 爱心飞舞动画 */
.love-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 133, 162, 0.3);
  z-index: 9999;
  overflow: hidden;
  animation: maskIn 0.3s ease-out;
}
@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.love-hearts {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.heart {
  position: absolute;
  bottom: -60rpx;
  animation-name: heartFly;
  animation-timing-function: ease-out;
  animation-fill-mode: forwards;
}
@keyframes heartFly {
  0% {
    opacity: 0;
    transform: translateY(0) translateX(0) rotate(0deg) scale(0.5);
  }
  10% {
    opacity: 1;
    transform: translateY(-10vh) translateX(0) rotate(0deg) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateY(-110vh) translateX(var(--heart-x, 0rpx)) rotate(var(--heart-r, 0deg)) scale(1.3);
  }
}

.love-center {
  position: absolute;
  top: 50%;
  left: 50%;
  text-align: center;
  animation: loveCenterIn 0.5s ease-out;
}
@keyframes loveCenterIn {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
.love-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 8rpx solid #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 138, 0.4);
}
.love-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-top: 30rpx;
  text-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.6);
}
