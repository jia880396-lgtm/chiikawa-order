.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #FFFFFF;
  display: flex;
  box-shadow: 0 -4rpx 20rpx rgba(255, 133, 162, 0.1);
  border-top: 2rpx solid #FFE5EC;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  font-size: 44rpx;
  line-height: 1;
  transition: transform 0.2s;
}
.tab-icon-active {
  transform: scale(1.2) translateY(-2rpx);
}
.tab-text {
  font-size: 22rpx;
  margin-top: 8rpx;
}
